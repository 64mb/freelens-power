{
  "name": "@64mb/freelens-power",
  "version": "2.21.2",
  "description": "Power tools for Freelens Kubernetes IDE",
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*",
    "!dist/**/duckdb/**",
    "THIRD_PARTY_LICENSES"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "copyright": "© 2025-2026 Freelens Authors",
  "license": "Apache-2.0",
  "author": "64mb",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.5.1",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "type:check": "pnpm type:check:sources && pnpm type:check:tests && pnpm type:check:tooling",
    "prebuild": "pnpm type:check",
    "build": "vite build && vite build --mode main && vite build --mode preload",
    "build:production": "pnpm build",
    "bump-version": "pnpm version --no-commit-hooks --no-git-tag-version",
    "pack:dev": "pnpm build && pnpm pack",
    "clean": "pnpm clean:out",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:out": "pnpm dlx shx@0.4.0 rm -rf dist",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(node_modules|out|tgz)\\$/\"",
    "dev": "pnpm \"/^dev:(renderer|main|preload)\\$/\"",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:provision": "node e2e/provision.mjs",
    "type:check:e2e": "tsc -p e2e/tsconfig.json",
    "test:packaging": "pnpm build && node --test build/power-logs-assets.test.mjs",
    "type:check:sources": "tsc -p src/main && tsc -p src/renderer && tsc -p src/common && tsc -p src/preload && tsc -p src/browser",
    "type:check:tests": "tsc -p src/tsconfig.json",
    "type:check:tooling": "tsc -p tsconfig.json",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "dev:main": "vite build --watch --mode main",
    "dev:preload": "vite build --watch --mode preload"
  },
  "devDependencies": {
    "@freelensapp/extensions": "2.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass-embedded": "1.105.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens"
  ],
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "dependencies": {
    "markdown-it": "15.0.2",
    "react-select": "5.10.2",
    "ws": "8.21.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/64mb/freelens-power.git"
  },
  "homepage": "https://github.com/64mb/freelens-power",
  "bugs": {
    "url": "https://github.com/64mb/freelens-power/issues"
  },
  "type": "module"
}
